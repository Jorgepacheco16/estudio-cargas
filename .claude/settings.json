{
  "permissions": {
    "allow": ["Bash(npm run *)", "Bash(npx tsc *)", "Bash(npx drizzle-kit *)", "Bash(npx tsx *)", "Bash(supabase *)", "Bash(git status)", "Bash(git diff*)", "Bash(git add *)", "Bash(git commit *)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/service-account*.json)", "Bash(git push --force*)", "Bash(rm -rf *)", "Bash(curl * | sh)", "Bash(supabase db reset --linked*)", "Bash(supabase db push*)"]
  },
  "hooks": {
    "PreToolUse": [{ "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node .claude/hooks/block-secrets.js" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "npm run verify" }] }]
  }
}
