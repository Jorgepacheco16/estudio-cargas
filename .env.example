# Copie a .env.local (NO se versiona). En producción, defina estas variables en Vercel (Settings → Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=                 # conexión de la app: rol app_user (sin BYPASSRLS), pooler de Supabase, puerto 6543
DATABASE_URL_MIGRATIONS=      # conexión directa (puerto 5432) con el rol dueño; solo para migraciones, nunca en Vercel runtime
SUPABASE_SERVICE_ROLE_KEY=    # solo servidor; jamás NEXT_PUBLIC_
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=  # JSON de la cuenta de servicio en una sola línea
SHEETS_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
